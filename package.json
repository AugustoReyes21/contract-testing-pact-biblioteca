{
  "name": "contract-testing-pact-biblioteca",
  "version": "1.0.0",
  "description": "Contract testing con Pact entre BibliotecaWeb (consumidor) y BibliotecaAPI (proveedor)",
  "scripts": {
    "pretest:consumer": "node -e \"require('fs').rmSync('pacts',{recursive:true,force:true})\"",
    "test:consumer": "jest test/consumer --verbose",
    "test:provider": "jest test/provider --verbose",
    "test": "npm run test:consumer && npm run test:provider",
    "start:provider": "ts-node src/provider/server.ts",
    "break:apply": "git apply breaking-change/romper-contrato.patch",
    "break:revert": "git apply -R breaking-change/romper-contrato.patch"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.21.0",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@pact-foundation/pact": "^17.1.4",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
